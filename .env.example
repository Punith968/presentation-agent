PORT=3000

# At least one LLM provider key is required.
# OpenRouter (https://openrouter.ai) - primary: Llama 3.1 8B, then Llama 3.3 70B.
# Also used by the optional slide-image analysis helper.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# NVIDIA NIM (https://build.nvidia.com) - fallback: Llama 3.2 11B.
NVIDIA_API_KEY=

# Optional: path to the edge-tts binary and the neural voice to use.
# If edge-tts is unavailable the browser's Web Speech API is used instead.
EDGE_TTS_PATH=
TTS_VOICE=en-US-AriaNeural
